# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all of them, no exceptions. The seam is documented in
# ARCHITECTURE.md + ADR-0015 rather than in a committed template.
# Never add a .env.local: Next loads it in every mode and it silently
# overrides .env.production in a local prod build (ADR-0015).
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# next-agents-md
.next-docs/

certificates